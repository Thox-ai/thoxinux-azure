{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Deploy the real ThoxInux kernel in QEMU TCG on an Azure Ubuntu host. Select Create new resource group. This portal entry point does not run the CLI ownership safeguards.",
    "generatedFrom": "azuredeploy.json and cloud-init.yaml; run python3 portal/build_portal.py",
    "cloudInitSha256": "e30124825c35c58665cbcc19daf5ee8b07fb6596f0db244b71ad5112caa3932f",
    "kernelRelease": "v0.9.1",
    "kernelSha256": "1bc1c7af33470edc009fa5756d3fe6063573660e07e157d19397afc680a7bb89",
    "hostImagePolicy": "Resolve Ubuntu24.04 latest at deployment; record imageReference.exactVersion in deployment outputs."
  },
  "parameters": {
    "vmName": {
      "type": "string",
      "defaultValue": "[concat('thoxinux-', uniqueString(resourceGroup().id))]",
      "minLength": 3,
      "maxLength": 63,
      "metadata": {
        "description": "VM name in a NEW dedicated resource group. Use lowercase letters, digits and hyphens. The default adds a stable resource-group suffix to reduce collisions."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the VM. Defaults to the new resource group's location; the selected Dsv5 size must be available with sufficient subscription quota."
      }
    },
    "vmSize": {
      "type": "string",
      "defaultValue": "Standard_D2s_v5",
      "allowedValues": [
        "Standard_D2s_v5",
        "Standard_D4s_v5"
      ],
      "metadata": {
        "description": "D2s_v5: 2 vCPU / 8 GiB host RAM. D4s_v5: 4 vCPU / 16 GiB. The validated ThoxInux guest stays at 1 vCPU / 2 GiB. Compute, disk and public IPv4 are billable."
      }
    },
    "sshPublicKey": {
      "type": "secureString",
      "minLength": 40,
      "maxLength": 8192,
      "metadata": {
        "description": "Paste one existing OpenSSH public key (ssh-ed25519 or ssh-rsa). Do not paste a private key. No inbound SSH port is opened; management uses Azure Run Command."
      }
    }
  },
  "variables": {
    "nsgName": "[concat(parameters('vmName'), '-nsg')]",
    "vnetName": "[concat(parameters('vmName'), '-vnet')]",
    "subnetName": "kernel",
    "nicName": "[concat(parameters('vmName'), '-nic')]",
    "publicIpName": "[concat(parameters('vmName'), '-egress-ip')]",
    "tags": {
      "thox-project": "thoxinux-kernel",
      "thox-instance": "[parameters('vmName')]",
      "thox-entrypoint": "azure-portal",
      "thox-cloudinit-sha256": "e30124825c35c58665cbcc19daf5ee8b07fb6596f0db244b71ad5112caa3932f",
      "thox-kernel-release": "v0.9.1"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2024-05-01",
      "name": "[variables('nsgName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "securityRules": [
          {
            "name": "DenyAllInbound",
            "properties": {
              "priority": 100,
              "direction": "Inbound",
              "access": "Deny",
              "protocol": "*",
              "sourcePortRange": "*",
              "destinationPortRange": "*",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "*"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2024-05-01",
      "name": "[variables('publicIpName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "publicIPAddressVersion": "IPv4",
        "idleTimeoutInMinutes": 4
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2024-05-01",
      "name": "[variables('vnetName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
      ],
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.73.0.0/24"
          ]
        },
        "subnets": [
          {
            "name": "[variables('subnetName')]",
            "properties": {
              "addressPrefix": "10.73.0.0/27",
              "defaultOutboundAccess": false,
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2024-05-01",
      "name": "[variables('nicName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]",
        "[resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpName'))]"
      ],
      "properties": {
        "enableAcceleratedNetworking": true,
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), variables('subnetName'))]"
              },
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpName'))]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2024-07-01",
      "name": "[parameters('vmName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', variables('nicName'))]"
      ],
      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('vmSize')]"
        },
        "securityProfile": {
          "securityType": "TrustedLaunch",
          "uefiSettings": {
            "secureBootEnabled": true,
            "vTpmEnabled": true
          }
        },
        "osProfile": {
          "computerName": "[parameters('vmName')]",
          "adminUsername": "thoxadmin",
          "customData": "",
          "linuxConfiguration": {
            "disablePasswordAuthentication": true,
            "provisionVMAgent": true,
            "ssh": {
              "publicKeys": [
                {
                  "path": "/home/thoxadmin/.ssh/authorized_keys",
                  "keyData": "[parameters('sshPublicKey')]"
                }
              ]
            }
          }
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "Canonical",
            "offer": "ubuntu-24_04-lts",
            "sku": "server",
            "version": "latest"
          },
          "osDisk": {
            "name": "[concat(parameters('vmName'), '-os')]",
            "createOption": "FromImage",
            "diskSizeGB": 128,
            "caching": "ReadWrite",
            "managedDisk": {
              "storageAccountType": "StandardSSD_LRS"
            },
            "deleteOption": "Detach"
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('nicName'))]",
              "properties": {
                "primary": true,
                "deleteOption": "Detach"
              }
            }
          ]
        },
        "diagnosticsProfile": {
          "bootDiagnostics": {
            "enabled": true
          }
        }
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2024-07-01",
      "name": "[concat(parameters('vmName'), '/thoxinux-guest-acceptance')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines', parameters('vmName'))]"
      ],
      "properties": {
        "publisher": "Microsoft.Azure.Extensions",
        "type": "CustomScript",
        "typeHandlerVersion": "2.1",
        "autoUpgradeMinorVersion": true,
        "forceUpdateTag": "[deployment().name]",
        "settings": {
          "commandToExecute": "/bin/bash -c 'set -euo pipefail\ntimeout 900s cloud-init status --wait --long\nsystemctl is-active --quiet thoxinux.service\n/usr/local/bin/thox-kernel status'"
        }
      }
    }
  ],
  "outputs": {
    "vmResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Compute/virtualMachines', parameters('vmName'))]"
    },
    "vmName": {
      "type": "string",
      "value": "[parameters('vmName')]"
    },
    "publicIpPurpose": {
      "type": "string",
      "value": "Explicit outbound only. The NSG denies all inbound; no SSH/RDP ports are exposed."
    },
    "guestEvidence": {
      "type": "string",
      "value": "Use Azure Run Command to inspect /var/log/thoxinux/acceptance.json and thoxinux.service. Host provisioning alone does not prove the ThoxInux guest is running."
    },
    "kernelRelease": {
      "type": "string",
      "value": "v0.9.1"
    },
    "kernelSha256": {
      "type": "string",
      "value": "1bc1c7af33470edc009fa5756d3fe6063573660e07e157d19397afc680a7bb89"
    },
    "cloudInitSha256": {
      "type": "string",
      "value": "e30124825c35c58665cbcc19daf5ee8b07fb6596f0db244b71ad5112caa3932f"
    },
    "deployedUbuntuImageVersion": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Compute/virtualMachines', parameters('vmName')), '2024-07-01').storageProfile.imageReference.exactVersion]"
    },
    "guestAcceptanceCommand": {
      "type": "string",
      "value": "sudo /usr/local/bin/thox-kernel status"
    },
    "guestConsoleLogCommand": {
      "type": "string",
      "value": "sudo /usr/local/bin/thox-kernel logs --lines 30"
    },
    "acceptanceBoundary": {
      "type": "string",
      "value": "The thoxinux-guest-acceptance extension waits for cloud-init and requires a running, accepted guest before initial deployment succeeds. This is point-in-time evidence; use guestAcceptanceCommand for current status."
    }
  }
}
